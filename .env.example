# Wix app credentials (app dashboard > OAuth). The app uses Wix OAuth (client credentials).
WIX_APP_ID=
WIX_APP_SECRET=
# App dashboard > Webhooks > Public key (PEM, newlines as \n). Needed for App Instance Installed / Removed.
WIX_PUBLIC_KEY=

# Public HTTPS URL of this app
APP_URL=https://your-app.example.com

# Optional overrides
PORT=3059
CONFERBOT_WIDGET_URL=https://cdn.conferbot.com/dist/v1/widget.min.js
# WIX_API_BASE=https://www.wixapis.com
# DATA_FILE=./data/sites.json
